Cell[BoxData[
 RowBox[{
  RowBox[{"MakeRoots", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sol", ",", "name", ",", "out"}], "}"}], ",", 
    RowBox[{
     RowBox[{"sol", "=", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LaguerreL", "[", 
          RowBox[{"n", ",", "x"}], "]"}], "==", "0"}], ",", "x", ",", 
        RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], ";", 
     RowBox[{"out", "=", 
      RowBox[{"x", "/.", "sol"}]}], ";", 
     RowBox[{"name", "=", 
      RowBox[{"\"\<roots_\>\"", "<>", 
       RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<.dat\>\""}]}], ";", 
     RowBox[{"Export", "[", 
      RowBox[{"name", ",", "out", ",", "\"\<Table\>\""}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.988320063708379*^9, 3.9883201906876507`*^9}, {
